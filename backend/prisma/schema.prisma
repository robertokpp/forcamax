// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  beginner
  intermediary
  advanced
}

enum tag {
  push
  pull
  legs
  full
  core
  hit
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  Training         Training[]
  trainingSessions TrainingSession[]

  @@map("users")
}

model Exercise {
  id          String  @id @default(uuid())
  name        String
  description String
  muscleGroup String
  equipment   String?

  training          Training[]
  trainingExercises TrainingExercise[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessionExercises SessionExercise[]

  @@map("exercise")
}

model Training {
  id          String  @id @default(uuid())
  name        String
  description String?

  TargetMuscles TargetMuscles[]

  tag        tag
  difficulty Difficulty

  userId String
  user   User   @relation(fields: [userId], references: [id])

  exercises         Exercise[]
  trainingExercises TrainingExercise[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  trainingSessions TrainingSession[]

  @@map("Training")
}

model TrainingExercise {
  id String @id @default(uuid())

  trainingId String
  training   Training @relation(fields: [trainingId], references: [id])

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  sets        Int?
  repetitions String?
  weight      String?
  interval    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TargetMuscles {
  id String @id @default(uuid())

  name String?

  trainings Training[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum SessionStatus {
  planned
  in_progress
  completed
  cancelled
}

enum SetStatus {
  pending
  completed
  skipped
}

model TrainingSession {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  trainingId String
  training   Training @relation(fields: [trainingId], references: [id])

  status     SessionStatus @default(planned)
  startedAt  DateTime?
  finishedAt DateTime?
  notes      String?

  exercises SessionExercise[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([trainingId])
  @@map("training_sessions")
}

model SessionExercise {
  id String @id @default(uuid())

  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id])

  exerciseId String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])

  // Cópia do nome para preservar o histórico.
  exerciseName String
  position     Int
  notes        String?

  sets SessionSet[]

  @@unique([sessionId, position])
  @@index([exerciseId])
  @@map("session_exercises")
}

model SessionSet {
  id String @id @default(uuid())

  sessionExerciseId String
  sessionExercise   SessionExercise @relation(fields: [sessionExerciseId], references: [id])

  number Int
  status SetStatus @default(pending)

  // Prescrição copiada da ficha no início da sessão.
  plannedRepetitions String?
  plannedWeight      String?
  plannedRest        String?

  // Resultado efetivamente executado.
  actualRepetitions Int?
  actualWeightKg    Decimal? @db.Decimal(7, 2)
  actualDurationSec Int?
  actualDistanceM   Decimal? @db.Decimal(10, 2)
  actualRestSec     Int?

  completedAt DateTime?
  notes       String?

  @@unique([sessionExerciseId, number])
  @@map("session_sets")
}
